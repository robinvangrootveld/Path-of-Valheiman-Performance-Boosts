<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Path of Valheiman v2.0.0 — Artwork Animator & Seamless GIF Studio</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700&family=Inter:wght@400;500;600;700&display=swap');

    :root {
      color-scheme: dark;
    }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      background: radial-gradient(circle at 50% 0%, #101d2e 0%, #050810 72%);
      color: #e6edf7;
      min-height: 100vh;
      overflow-x: hidden;
    }

    .font-runic {
      font-family: 'Cinzel', Georgia, serif;
    }

    .stage-frame {
      box-shadow:
        0 26px 64px rgba(0, 0, 0, 0.78),
        0 0 0 1px rgba(132, 214, 255, 0.16),
        inset 0 0 36px rgba(0, 0, 0, 0.45);
    }

    .drop-active {
      box-shadow:
        0 0 0 2px #fbbf24,
        0 0 36px rgba(251, 191, 36, 0.35);
    }

    canvas#slideCanvas {
      display: block;
      width: 100%;
      height: 100%;
      border-radius: 0.75rem;
    }
  </style>
</head>
<body class="antialiased selection:bg-amber-400/30 selection:text-amber-100">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-5 sm:py-7 flex flex-col gap-5">

    <!-- Top Header & Slide Switcher -->
    <header class="flex flex-wrap items-center justify-between gap-4 bg-slate-900/80 border border-slate-700/60 rounded-2xl px-4 sm:px-5 py-3.5 backdrop-blur-md">
      <div>
        <div class="flex items-center gap-2.5">
          <span class="inline-block w-2.5 h-2.5 rounded-full bg-emerald-400 shadow-[0_0_10px_#34d399]"></span>
          <h1 class="font-runic text-lg sm:text-xl font-bold tracking-wide text-amber-300">
            Path of Valheiman Artwork Animator
          </h1>
        </div>
        <p class="text-xs sm:text-sm text-slate-400 mt-0.5">
          Bring your generated Slide 1 &amp; Slide 2 images directly to life with pixel-exact aurora, ribbon blooms, rune glow &amp; seamless GIF loops
        </p>
      </div>

      <!-- Slide Slot Switcher -->
      <div class="flex items-center gap-2 bg-slate-950/85 p-1 rounded-xl border border-slate-800">
        <button
          id="btnSlide1"
          type="button"
          class="px-3.5 py-2 rounded-lg text-xs sm:text-sm font-semibold transition-all cursor-pointer bg-amber-400/20 text-amber-200 border border-amber-400/50 shadow-sm flex items-center gap-2"
        >
          <span>Slide 1: Monolith</span>
          <span id="dotSlide1" class="w-2 h-2 rounded-full bg-slate-600" title="Artwork status"></span>
        </button>
        <button
          id="btnSlide2"
          type="button"
          class="px-3.5 py-2 rounded-lg text-xs sm:text-sm font-semibold transition-all cursor-pointer text-slate-300 hover:text-white border border-transparent flex items-center gap-2"
        >
          <span>Slide 2: Three Pillars</span>
          <span id="dotSlide2" class="w-2 h-2 rounded-full bg-slate-600" title="Artwork status"></span>
        </button>
      </div>
    </header>

    <!-- Artwork Upload Strip -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-3">
      <label
        for="fileSlide1"
        id="cardUpload1"
        class="flex items-center justify-between gap-3 bg-slate-900/70 hover:bg-slate-900 border border-slate-700/60 hover:border-amber-400/50 rounded-2xl px-4 py-3 cursor-pointer transition"
      >
        <div class="min-w-0">
          <div class="text-xs font-semibold uppercase tracking-wider text-amber-300">Slide 1 Artwork</div>
          <div id="labelSlide1" class="text-xs sm:text-sm text-slate-300 truncate mt-0.5">
            Click or drop your Slide 1 image (What to Expect)
          </div>
        </div>
        <span class="shrink-0 px-3 py-1.5 rounded-lg text-xs font-semibold bg-amber-400/15 text-amber-200 border border-amber-400/40">
          Load Image
        </span>
        <input id="fileSlide1" type="file" accept="image/*" class="hidden" />
      </label>

      <label
        for="fileSlide2"
        id="cardUpload2"
        class="flex items-center justify-between gap-3 bg-slate-900/70 hover:bg-slate-900 border border-slate-700/60 hover:border-sky-400/50 rounded-2xl px-4 py-3 cursor-pointer transition"
      >
        <div class="min-w-0">
          <div class="text-xs font-semibold uppercase tracking-wider text-sky-300">Slide 2 Artwork</div>
          <div id="labelSlide2" class="text-xs sm:text-sm text-slate-300 truncate mt-0.5">
            Click or drop your Slide 2 image (Performance Pillars)
          </div>
        </div>
        <span class="shrink-0 px-3 py-1.5 rounded-lg text-xs font-semibold bg-sky-400/15 text-sky-200 border border-sky-400/40">
          Load Image
        </span>
        <input id="fileSlide2" type="file" accept="image/*" class="hidden" />
      </label>
    </section>

    <!-- 16:9 Live Preview Stage -->
    <main class="flex flex-col gap-4">
      <div id="stageContainer" class="stage-frame relative w-full aspect-video rounded-2xl bg-slate-950 p-1.5 sm:p-2 transition-shadow">
        <canvas id="slideCanvas"></canvas>

        <!-- Seamless Loop Phase Indicator -->
        <div class="pointer-events-none absolute bottom-3.5 right-4 flex items-center gap-2 bg-slate-950/75 border border-slate-700/60 rounded-full px-3 py-1 text-[11px] text-slate-300 backdrop-blur-sm">
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          <span>Seamless Loop:</span>
          <span id="loopPhaseLabel" class="font-mono text-amber-300 min-w-[5.25rem] text-right">8.0s · 0%</span>
        </div>

        <!-- Empty-Slot Drop Hint Overlay (hidden automatically once artwork is loaded) -->
        <div
          id="emptyPrompt"
          class="absolute inset-2 rounded-xl flex flex-col items-center justify-center text-center px-6 bg-slate-950/55 backdrop-blur-[2px] border border-dashed border-amber-400/45 transition-opacity"
        >
          <div class="max-w-md bg-slate-950/85 border border-slate-700/70 rounded-2xl p-5 shadow-2xl">
            <div class="font-runic text-amber-300 text-base sm:text-lg font-bold">
              Drop Your Generated Slide Artwork Here
            </div>
            <p class="text-xs sm:text-sm text-slate-300 mt-1.5 leading-relaxed">
              Drag &amp; drop the JPEG/PNG image for <span id="emptySlideName" class="text-amber-200 font-semibold">Slide 1</span> onto this canvas (or click <span class="text-amber-200 font-semibold">Load Image</span> above). The studio will extract its exact aurora, carved rune letters, and blue/gold ribbons so your real artwork comes alive.
            </p>
          </div>
        </div>
      </div>

      <!-- Controls Deck -->
      <section class="bg-slate-900/80 border border-slate-700/60 rounded-2xl p-4 sm:p-5 backdrop-blur-md flex flex-col gap-4">

        <!-- Row 1: Playback, Sound, Alignment, Export -->
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div class="flex flex-wrap items-center gap-2">
            <button
              id="btnPlayPause"
              type="button"
              class="px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold bg-sky-500/20 hover:bg-sky-500/30 text-sky-200 border border-sky-400/40 transition cursor-pointer"
            >
              Pause
            </button>

            <button
              id="btnAudio"
              type="button"
              class="px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-600/60 transition cursor-pointer"
            >
              Ambient Drone: Off
            </button>

            <button
              id="btnOverlay"
              type="button"
              class="px-3.5 py-2.5 rounded-xl text-xs sm:text-sm font-semibold bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-600/60 transition cursor-pointer"
              title="Preview the extracted aurora, rune, and ribbon guide zones"
            >
              Mask Guides: Off
            </button>
          </div>

          <!-- Export Resolution, Loop Length & Button -->
          <div class="flex flex-wrap items-center gap-2">
            <select
              id="exportRes"
              aria-label="Export Resolution"
              class="bg-slate-950 text-slate-200 text-xs sm:text-sm rounded-xl px-3 py-2.5 border border-slate-700 focus:outline-none focus:border-amber-400 cursor-pointer"
            >
              <option value="960x540" selected>960x540 (Crisp &amp; Fast for GitHub/Gale)</option>
              <option value="1280x720">1280x720 (HD)</option>
            </select>

            <select
              id="loopSeconds"
              aria-label="Loop Duration"
              class="bg-slate-950 text-slate-200 text-xs sm:text-sm rounded-xl px-3 py-2.5 border border-slate-700 focus:outline-none focus:border-amber-400 cursor-pointer"
            >
              <option value="5.0">5.0s Base (Brisk)</option>
              <option value="8.0" selected>8.0s Base (Calm 1×)</option>
              <option value="10.0">10.0s Base (Dreamy)</option>
              <option value="12.0">12.0s Base (Ultra-Slow)</option>
            </select>

            <button
              id="btnExportGif"
              type="button"
              class="px-4 py-2.5 rounded-xl text-xs sm:text-sm font-bold bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-400 hover:to-orange-400 text-slate-950 shadow-lg shadow-amber-500/20 transition cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
            >
              Export Seamless GIF
            </button>
          </div>
        </div>

        <!-- Row 2: Live Effect Intensity & Speed Sliders -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 pt-1 border-t border-slate-800/80">
          <div class="bg-slate-950/75 rounded-xl px-3.5 py-2.5 border border-slate-800">
            <div class="flex justify-between text-xs mb-1.5">
              <span class="text-emerald-300 font-medium">Aurora Seesaw</span>
              <span id="valAurora" class="text-slate-300 font-mono">100%</span>
            </div>
            <input id="slAurora" type="range" min="0" max="160" value="100" class="w-full accent-emerald-400 cursor-pointer" />
            <div class="flex justify-between text-[11px] mt-2 mb-1 text-slate-400">
              <span>Speed <span class="text-slate-500">(0.25×–3×)</span></span>
              <span id="valSpdAurora" class="text-emerald-200/90 font-mono">1×</span>
            </div>
            <input id="slSpdAurora" type="range" min="0.25" max="3" step="0.25" value="1" class="w-full accent-emerald-400 cursor-pointer" />
          </div>

          <div class="bg-slate-950/75 rounded-xl px-3.5 py-2.5 border border-slate-800">
            <div class="flex justify-between text-xs mb-1.5">
              <span class="text-sky-300 font-medium">Electric Ribbon Flow</span>
              <span id="valRibbon" class="text-slate-300 font-mono">100%</span>
            </div>
            <input id="slRibbon" type="range" min="0" max="160" value="100" class="w-full accent-sky-400 cursor-pointer" />
            <div class="flex justify-between text-[11px] mt-2 mb-1 text-slate-400">
              <span>Speed <span class="text-slate-500">(0.25×–3×)</span></span>
              <span id="valSpdRibbon" class="text-sky-200/90 font-mono">1×</span>
            </div>
            <input id="slSpdRibbon" type="range" min="0.25" max="3" step="0.25" value="1" class="w-full accent-sky-400 cursor-pointer" />
          </div>

          <div class="bg-slate-950/75 rounded-xl px-3.5 py-2.5 border border-slate-800">
            <div class="flex justify-between text-xs mb-1.5">
              <span class="text-amber-300 font-medium">Rune Letter Glow</span>
              <span id="valRune" class="text-slate-300 font-mono">100%</span>
            </div>
            <input id="slRune" type="range" min="0" max="160" value="100" class="w-full accent-amber-400 cursor-pointer" />
            <div class="flex justify-between text-[11px] mt-2 mb-1 text-slate-400">
              <span>Speed <span class="text-slate-500">(0.25×–3×)</span></span>
              <span id="valSpdRune" class="text-amber-200/90 font-mono">1×</span>
            </div>
            <input id="slSpdRune" type="range" min="0.25" max="3" step="0.25" value="1" class="w-full accent-amber-400 cursor-pointer" />
          </div>

          <div class="bg-slate-950/75 rounded-xl px-3.5 py-2.5 border border-slate-800">
            <div class="flex justify-between text-xs mb-1.5">
              <span class="text-indigo-300 font-medium">Embers &amp; Sparks</span>
              <span id="valSparks" class="text-slate-300 font-mono">70%</span>
            </div>
            <input id="slSparks" type="range" min="0" max="150" value="70" class="w-full accent-indigo-400 cursor-pointer" />
            <div class="flex justify-between text-[11px] mt-2 mb-1 text-slate-400">
              <span>Speed <span class="text-slate-500">(0.25×–3×)</span></span>
              <span id="valSpdSparks" class="text-indigo-200/90 font-mono">1×</span>
            </div>
            <input id="slSpdSparks" type="range" min="0.25" max="3" step="0.25" value="1" class="w-full accent-indigo-400 cursor-pointer" />
          </div>
        </div>

        <!-- Status / Export Progress Banner -->
        <div id="statusBox" class="hidden rounded-xl px-4 py-2.5 text-xs sm:text-sm border transition-all"></div>
      </section>
    </main>
  </div>

  <script>
    (function () {
      'use strict';

      // =========================================================================
      // 1. Canonical Coordinates & Artwork-Exact Feature Maps
      //    Normalized [0..1] coordinates matched precisely to the generated
      //    Slide 1 (single monolith + Viking) and Slide 2 (three stone pillars).
      // =========================================================================
      const MASK_W = 640;
      const MASK_H = 360;

      const SLIDE_META = {
        1: {
          filename: 'slide_01_what_to_expect.gif',
          displayName: 'Slide 1 (What to Expect)',
          // Stone face ellipses where carved golden rune letters live
          runeZones: [
            { cx: 0.708, cy: 0.548, rx: 0.068, ry: 0.185, coreRx: 0.036, coreRy: 0.130, phaseOffset: 0.0 }
          ],
          // Floating sky runes on the right side
          skyRunes: [
            { x: 0.625, y: 0.455 }, { x: 0.780, y: 0.370 }, { x: 0.912, y: 0.210 },
            { x: 0.942, y: 0.195 }, { x: 0.958, y: 0.335 }, { x: 0.655, y: 0.875 }
          ],
          // Traced blue/cyan ribbon from start (top-right) around the rune stone to bottom end
          blueSpline: [
            { x: 0.992, y: 0.070 },
            { x: 0.905, y: 0.240 },
            { x: 0.815, y: 0.405 },
            { x: 0.735, y: 0.475 },
            { x: 0.640, y: 0.545 },
            { x: 0.585, y: 0.665 },
            { x: 0.548, y: 0.805 },
            { x: 0.618, y: 0.945 },
            { x: 0.755, y: 0.915 },
            { x: 0.842, y: 0.815 },
            { x: 0.755, y: 0.718 },
            { x: 0.660, y: 0.775 },
            { x: 0.785, y: 0.975 }
          ],
          // Traced orange-yellow golden ribbon from start (upper-right) around stone to bottom end
          goldSpline: [
            { x: 0.988, y: 0.240 },
            { x: 0.875, y: 0.395 },
            { x: 0.775, y: 0.535 },
            { x: 0.705, y: 0.690 },
            { x: 0.595, y: 0.735 },
            { x: 0.635, y: 0.865 },
            { x: 0.778, y: 0.878 },
            { x: 0.745, y: 0.758 },
            { x: 0.688, y: 0.885 },
            { x: 0.745, y: 0.990 }
          ]
        },
        2: {
          filename: 'slide_02_mod_application_and_pillars.gif',
          displayName: 'Slide 2 (Performance Pillars)',
          // Three standing rune pillars
          runeZones: [
            { cx: 0.682, cy: 0.525, rx: 0.036, ry: 0.130, coreRx: 0.020, coreRy: 0.095, phaseOffset: 0.12 },
            { cx: 0.768, cy: 0.445, rx: 0.042, ry: 0.185, coreRx: 0.024, coreRy: 0.145, phaseOffset: 0.0 },
            { cx: 0.858, cy: 0.482, rx: 0.038, ry: 0.150, coreRx: 0.022, coreRy: 0.112, phaseOffset: 0.24 }
          ],
          skyRunes: [
            { x: 0.652, y: 0.878 }
          ],
          blueSpline: [
            { x: 0.992, y: 0.115 },
            { x: 0.895, y: 0.285 },
            { x: 0.790, y: 0.430 },
            { x: 0.675, y: 0.550 },
            { x: 0.575, y: 0.685 },
            { x: 0.550, y: 0.835 },
            { x: 0.648, y: 0.960 },
            { x: 0.795, y: 0.900 },
            { x: 0.838, y: 0.790 },
            { x: 0.725, y: 0.745 },
            { x: 0.790, y: 0.985 }
          ],
          goldSpline: [
            { x: 0.975, y: 0.255 },
            { x: 0.865, y: 0.435 },
            { x: 0.780, y: 0.595 },
            { x: 0.708, y: 0.655 },
            { x: 0.612, y: 0.725 },
            { x: 0.655, y: 0.865 },
            { x: 0.785, y: 0.880 },
            { x: 0.822, y: 0.805 },
            { x: 0.730, y: 0.975 }
          ]
        }
      };

      // =========================================================================
      // 2. DOM References & Studio State
      // =========================================================================
      const canvas = document.getElementById('slideCanvas');
      const ctx = canvas.getContext('2d', { alpha: false });
      const stageContainer = document.getElementById('stageContainer');
      const emptyPrompt = document.getElementById('emptyPrompt');
      const emptySlideName = document.getElementById('emptySlideName');
      const loopPhaseLabel = document.getElementById('loopPhaseLabel');

      const btnSlide1 = document.getElementById('btnSlide1');
      const btnSlide2 = document.getElementById('btnSlide2');
      const dotSlide1 = document.getElementById('dotSlide1');
      const dotSlide2 = document.getElementById('dotSlide2');
      const cardUpload1 = document.getElementById('cardUpload1');
      const cardUpload2 = document.getElementById('cardUpload2');
      const fileSlide1 = document.getElementById('fileSlide1');
      const fileSlide2 = document.getElementById('fileSlide2');
      const labelSlide1 = document.getElementById('labelSlide1');
      const labelSlide2 = document.getElementById('labelSlide2');

      const btnPlayPause = document.getElementById('btnPlayPause');
      const btnAudio = document.getElementById('btnAudio');
      const btnOverlay = document.getElementById('btnOverlay');
      const exportResSelect = document.getElementById('exportRes');
      const loopSecondsSelect = document.getElementById('loopSeconds');
      const btnExportGif = document.getElementById('btnExportGif');
      const statusBox = document.getElementById('statusBox');

      const slAurora = document.getElementById('slAurora');
      const slRibbon = document.getElementById('slRibbon');
      const slRune = document.getElementById('slRune');
      const slSparks = document.getElementById('slSparks');
      const valAurora = document.getElementById('valAurora');
      const valRibbon = document.getElementById('valRibbon');
      const valRune = document.getElementById('valRune');
      const valSparks = document.getElementById('valSparks');

      const slSpdAurora = document.getElementById('slSpdAurora');
      const slSpdRibbon = document.getElementById('slSpdRibbon');
      const slSpdRune = document.getElementById('slSpdRune');
      const slSpdSparks = document.getElementById('slSpdSparks');
      const valSpdAurora = document.getElementById('valSpdAurora');
      const valSpdRibbon = document.getElementById('valSpdRibbon');
      const valSpdRune = document.getElementById('valSpdRune');
      const valSpdSparks = document.getElementById('valSpdSparks');

      let activeSlide = 1;
      let isPlaying = true;
      let isExporting = false;
      let showGuides = false;
      let loopDuration = 8.0;
      let elapsedSec = 0.0;
      let loopPhase = 0.0; // strictly in [0, 1) — every effect is mathematically periodic over [0, 1)
      let lastStamp = null;

      let outW = 960;
      let outH = 540;

      const params = {
        aurora: 1.0,
        ribbon: 1.0,
        rune: 1.0,
        sparks: 0.7
      };

      // Speed multipliers (0.25x .. 3x in 0.25x steps); master loop extends cleanly by 1x/2x/4x for seamless GIFs
      const speeds = {
        aurora: 1,
        ribbon: 1,
        rune: 1,
        sparks: 1
      };

      function speedDenominator(v) {
        const q = Math.round(v * 4);
        if (q % 4 === 0) return 1;
        if (q % 2 === 0) return 2;
        return 4;
      }

      // Computes the exact integer multiplier (1, 2, or 4) so every active effect completes whole cycles over [0, 1)
      function getSeamlessLoopMultiplier() {
        let mult = 1;
        if (params.aurora > 0.01) mult = Math.max(mult, speedDenominator(speeds.aurora));
        if (params.ribbon > 0.01) mult = Math.max(mult, speedDenominator(speeds.ribbon));
        if (params.rune > 0.01) mult = Math.max(mult, speedDenominator(speeds.rune));
        if (params.sparks > 0.01) mult = Math.max(mult, speedDenominator(speeds.sparks));
        return mult;
      }

      function formatSpeed(v) {
        return `${Number(v.toFixed(2))}×`;
      }

      // Stored per-slide loaded artwork & pre-extracted pixel masks
      const slotData = {
        1: null,
        2: null
      };

      // Reusable offscreen ribbon buffer (MASK_W x MASK_H) for ultra-fast pixel-exact electric bloom
      const ribbonBufCanvas = document.createElement('canvas');
      ribbonBufCanvas.width = MASK_W;
      ribbonBufCanvas.height = MASK_H;
      const ribbonBufCtx = ribbonBufCanvas.getContext('2d');
      const ribbonImgData = ribbonBufCtx.createImageData(MASK_W, MASK_H);

      // Soft-blur helper canvas for electric bloom halo
      const ribbonBlurCanvas = document.createElement('canvas');
      ribbonBlurCanvas.width = MASK_W >> 1;
      ribbonBlurCanvas.height = MASK_H >> 1;
      const ribbonBlurCtx = ribbonBlurCanvas.getContext('2d');

      // Ambient Web Audio state (D2-A2-D3 warm harmonic drone)
      let audioCtx = null;
      let audioMaster = null;
      let audioFilterA = null;
      let audioNodes = [];
      let audioEnabled = false;

      // =========================================================================
      // 3. Math, Spline, Deterministic Embers & Helper Utilities
      // =========================================================================
      function clamp(v, lo, hi) {
        return v < lo ? lo : (v > hi ? hi : v);
      }

      function smoothstep(edge0, edge1, x) {
        const t = clamp((x - edge0) / (edge1 - edge0), 0, 1);
        return t * t * (3 - 2 * t);
      }

      function mulberry32(seed) {
        let a = seed >>> 0;
        return function () {
          a |= 0;
          a = (a + 0x6d2b79f5) | 0;
          let t = Math.imul(a ^ (a >>> 15), 1 | a);
          t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
          return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
        };
      }

      function createPeriodicEmbers(count) {
        const rand = mulberry32(20261126);
        const list = [];
        for (let i = 0; i < count; i++) {
          list.push({
            baseX: 0.53 + rand() * 0.44,
            baseY: 0.34 + rand() * 0.62,
            rise: 0.08 + rand() * 0.14,
            swayAmp: 0.008 + rand() * 0.016,
            swayFreq: rand() > 0.5 ? 1 : 2, // integer harmonics guarantee seamless loop
            phase: rand(),
            radius: 1.2 + rand() * 2.1,
            warm: rand() > 0.42
          });
        }
        return list;
      }

      const embers = createPeriodicEmbers(38);

      function evalCatmullRom(pts, u) {
        const n = pts.length;
        if (n < 2) return pts[0] || { x: 0, y: 0 };
        const scaled = clamp(u, 0, 0.999999) * (n - 1);
        const i = Math.floor(scaled);
        const t = scaled - i;
        const p0 = pts[Math.max(0, i - 1)];
        const p1 = pts[i];
        const p2 = pts[Math.min(n - 1, i + 1)];
        const p3 = pts[Math.min(n - 1, i + 2)];

        const t2 = t * t;
        const t3 = t2 * t;

        const x =
          0.5 *
          (2 * p1.x +
            (-p0.x + p2.x) * t +
            (2 * p0.x - 5 * p1.x + 4 * p2.x - p3.x) * t2 +
            (-p0.x + 3 * p1.x - 3 * p2.x + p3.x) * t3);
        const y =
          0.5 *
          (2 * p1.y +
            (-p0.y + p2.y) * t +
            (2 * p0.y - 5 * p1.y + 4 * p2.y - p3.y) * t2 +
            (-p0.y + 3 * p1.y - 3 * p2.y + p3.y) * t3);
        return { x, y };
      }

      function sampleSplineArcLength(pts, numSamples) {
        const raw = [];
        const dense = Math.max(240, numSamples * 3);
        let totalLen = 0;
        for (let i = 0; i <= dense; i++) {
          const p = evalCatmullRom(pts, i / dense);
          if (i > 0) {
            const dx = p.x - raw[i - 1].x;
            const dy = p.y - raw[i - 1].y;
            totalLen += Math.hypot(dx, dy);
          }
          raw.push({ x: p.x, y: p.y, len: totalLen });
        }

        const out = [];
        let cursor = 0;
        for (let k = 0; k < numSamples; k++) {
          const targetLen = (k / (numSamples - 1)) * totalLen;
          while (cursor < raw.length - 2 && raw[cursor + 1].len < targetLen) {
            cursor++;
          }
          const a = raw[cursor];
          const b = raw[cursor + 1];
          const seg = Math.max(1e-6, b.len - a.len);
          const frac = clamp((targetLen - a.len) / seg, 0, 1);
          out.push({
            x: a.x + (b.x - a.x) * frac,
            y: a.y + (b.y - a.y) * frac,
            s: k / (numSamples - 1)
          });
        }
        return out;
      }

      function nearestSplineInfo(nx, ny, samples) {
        let bestD2 = 1e9;
        let bestS = 0;
        // Aspect-corrected distance (16:9)
        const ax = 1.7777778;
        for (let i = 0; i < samples.length; i++) {
          const dx = (nx - samples[i].x) * ax;
          const dy = ny - samples[i].y;
          const d2 = dx * dx + dy * dy;
          if (d2 < bestD2) {
            bestD2 = d2;
            bestS = samples[i].s;
          }
        }
        return { dist: Math.sqrt(bestD2), s: bestS };
      }

      function drawImageCover(targetCtx, img, w, h) {
        const iw = img.naturalWidth || img.width;
        const ih = img.naturalHeight || img.height;
        const targetRatio = w / h;
        const imgRatio = iw / ih;
        let sx = 0;
        let sy = 0;
        let sw = iw;
        let sh = ih;
        if (imgRatio > targetRatio) {
          sw = ih * targetRatio;
          sx = (iw - sw) * 0.5;
        } else if (imgRatio < targetRatio) {
          sh = iw / targetRatio;
          sy = (ih - sh) * 0.5;
        }
        targetCtx.drawImage(img, sx, sy, sw, sh, 0, 0, w, h);
      }

      function showStatus(message, type) {
        statusBox.classList.remove(
          'hidden',
          'bg-sky-950/70', 'border-sky-500/40', 'text-sky-200',
          'bg-emerald-950/70', 'border-emerald-500/40', 'text-emerald-200',
          'bg-rose-950/70', 'border-rose-500/40', 'text-rose-200'
        );
        if (type === 'success') {
          statusBox.classList.add('bg-emerald-950/70', 'border-emerald-500/40', 'text-emerald-200');
        } else if (type === 'error') {
          statusBox.classList.add('bg-rose-950/70', 'border-rose-500/40', 'text-rose-200');
        } else {
          statusBox.classList.add('bg-sky-950/70', 'border-sky-500/40', 'text-sky-200');
        }
        statusBox.textContent = message;
      }

      // =========================================================================
      // 4. Pixel-Exact Feature Extraction from Loaded Artwork
      //    Extracts actual painted aurora curtains, carved rune letters,
      //    and swirling blue/gold ribbon pixels directly from your image!
      // =========================================================================
      function extractArtworkMasks(img, slideNum) {
        const meta = SLIDE_META[slideNum];
        const srcCanvas = document.createElement('canvas');
        srcCanvas.width = MASK_W;
        srcCanvas.height = MASK_H;
        const sCtx = srcCanvas.getContext('2d');
        drawImageCover(sCtx, img, MASK_W, MASK_H);
        const srcData = sCtx.getImageData(0, 0, MASK_W, MASK_H).data;

        const blueSamples = sampleSplineArcLength(meta.blueSpline, 110);
        const goldSamples = sampleSplineArcLength(meta.goldSpline, 110);

        // Two overlapping aurora sky-bank layers (left/mid & upper-right) for natural seesaw
        const auroraACanvas = document.createElement('canvas');
        auroraACanvas.width = MASK_W;
        auroraACanvas.height = MASK_H;
        const auroraACtx = auroraACanvas.getContext('2d');
        const auroraAImg = auroraACtx.createImageData(MASK_W, MASK_H);

        const auroraBCanvas = document.createElement('canvas');
        auroraBCanvas.width = MASK_W;
        auroraBCanvas.height = MASK_H;
        const auroraBCtx = auroraBCanvas.getContext('2d');
        const auroraBImg = auroraBCtx.createImageData(MASK_W, MASK_H);

        // Per-zone rune letter layers (each stone pillar can pulse slightly staggered)
        const runeLayers = meta.runeZones.map((zone) => {
          const cCore = document.createElement('canvas');
          cCore.width = MASK_W;
          cCore.height = MASK_H;
          const ctxCore = cCore.getContext('2d');
          const imgCore = ctxCore.createImageData(MASK_W, MASK_H);

          const cDim = document.createElement('canvas');
          cDim.width = MASK_W;
          cDim.height = MASK_H;
          const ctxDim = cDim.getContext('2d');
          const imgDim = ctxDim.createImageData(MASK_W, MASK_H);

          return { zone, cCore, ctxCore, imgCore, cDim, ctxDim, imgDim };
        });

        // Sparse pixel arrays for exact painted blue & golden ribbons
        // Stored as flat typed-like arrays for fast per-frame wave evaluation
        const bluePixels = [];
        const goldPixels = [];

        for (let y = 0; y < MASK_H; y++) {
          const ny = y / MASK_H;
          for (let x = 0; x < MASK_W; x++) {
            const nx = x / MASK_W;
            const idx = (y * MASK_W + x) * 4;
            const r = srcData[idx];
            const g = srcData[idx + 1];
            const b = srcData[idx + 2];
            const luma = (0.299 * r + 0.587 * g + 0.114 * b) / 255;

            // --- A. Northern Lights (Upper Sky Green/Teal/Emerald Curtains) ---
            if (ny < 0.52 && nx > 0.24) {
              // Exclude left text column softly and focus on sky green-cyan hues
              const textFade = smoothstep(0.26, 0.45, nx);
              const skyFade = 1.0 - smoothstep(0.32, 0.52, ny);
              const greenDominance = (g - Math.max(r * 1.08, b * 0.72)) / 255;
              const tealStrength = ((g * 0.65 + b * 0.35) - r * 1.15) / 255;
              const auroraScore = Math.max(greenDominance * 1.9, tealStrength * 1.45) * luma * textFade * skyFade;

              if (auroraScore > 0.035) {
                const alphaBase = clamp(auroraScore * 3.8, 0, 1);
                // Split smoothly into Bank A (mid-left sky) and Bank B (right-upper sky)
                const splitB = smoothstep(0.56, 0.78, nx);
                const splitA = 1.0 - splitB * 0.85;

                const aA = Math.round(clamp(alphaBase * splitA, 0, 1) * 255);
                if (aA > 2) {
                  auroraAImg.data[idx] = Math.min(255, Math.round(r * 0.75 + 25));
                  auroraAImg.data[idx + 1] = Math.min(255, Math.round(g * 1.18 + 38));
                  auroraAImg.data[idx + 2] = Math.min(255, Math.round(b * 1.05 + 28));
                  auroraAImg.data[idx + 3] = aA;
                }

                const aB = Math.round(clamp(alphaBase * (0.25 + splitB * 0.9), 0, 1) * 255);
                if (aB > 2) {
                  auroraBImg.data[idx] = Math.min(255, Math.round(r * 0.65 + 18));
                  auroraBImg.data[idx + 1] = Math.min(255, Math.round(g * 1.15 + 42));
                  auroraBImg.data[idx + 2] = Math.min(255, Math.round(b * 1.18 + 45));
                  auroraBImg.data[idx + 3] = aB;
                }
              }
            }

            // --- B. Carved Golden Rune Letters inside Stone Ellipses ---
            for (let z = 0; z < runeLayers.length; z++) {
              const rl = runeLayers[z];
              const zn = rl.zone;
              const dx = (nx - zn.cx) / zn.rx;
              const dy = (ny - zn.cy) / zn.ry;
              const distSq = dx * dx + dy * dy;
              if (distSq <= 1.0) {
                const edgeFalloff = 1.0 - smoothstep(0.62, 1.0, Math.sqrt(distSq));
                // Warm golden-amber carved rune pixels have strong R & G over B
                const warmth = (r * 0.65 + g * 0.35 - b * 0.95) / 255;
                if (warmth > 0.14 && r > 125) {
                  // Emphasize the brightest interior rune strokes ('letters') most intensely
                  const cdx = (nx - zn.cx) / zn.coreRx;
                  const cdy = (ny - zn.cy) / zn.coreRy;
                  const inCore = 1.0 - smoothstep(0.7, 1.25, Math.hypot(cdx, cdy));
                  const letterHot = smoothstep(0.45, 0.88, luma);
                  const boost = (0.55 + 0.65 * inCore) * (0.45 + 0.95 * letterHot);
                  const alphaCore = clamp(warmth * 2.5 * boost * edgeFalloff, 0, 1);

                  if (alphaCore > 0.03) {
                    rl.imgCore.data[idx] = 255;
                    rl.imgCore.data[idx + 1] = Math.min(255, Math.round(168 + 82 * letterHot));
                    rl.imgCore.data[idx + 2] = Math.min(255, Math.round(45 + 150 * letterHot * letterHot));
                    rl.imgCore.data[idx + 3] = Math.round(alphaCore * 255);

                    // Dark carved-stone shadow color used when pulsing "off" so letters genuinely dim down
                    rl.imgDim.data[idx] = 26;
                    rl.imgDim.data[idx + 1] = 22;
                    rl.imgDim.data[idx + 2] = 28;
                    rl.imgDim.data[idx + 3] = Math.round(clamp(alphaCore * 0.95, 0, 0.92) * 255);
                  }
                }
              }
            }

            // --- C. Swirling Light-Blue & Orange-Yellow Energy Ribbons (Right Half) ---
            if (nx > 0.50 && ny > 0.03) {
              // Avoid grabbing rune stone center letters into the gold ribbon mask
              let insideRuneCore = false;
              for (let z = 0; z < meta.runeZones.length; z++) {
                const zn = meta.runeZones[z];
                const d = Math.hypot((nx - zn.cx) / (zn.coreRx * 1.15), (ny - zn.cy) / (zn.coreRy * 1.02));
                if (d < 0.92) {
                  insideRuneCore = true;
                  break;
                }
              }

              // Bright electric cyan/light-blue ribbon pixels
              const blueSat = (b * 0.62 + g * 0.38 - r * 0.85) / 255;
              const brightCore = (b > 165 && g > 145 && b >= r * 0.98) ? ((b + g) / 510) : 0;
              if (blueSat > 0.09 || (brightCore > 0.72 && b > r + 10)) {
                const infoB = nearestSplineInfo(nx, ny, blueSamples);
                if (infoB.dist < 0.135) {
                  const prox = 1.0 - smoothstep(0.035, 0.135, infoB.dist);
                  const wBlue = clamp((blueSat * 2.2 + brightCore * 0.95) * prox * smoothstep(0.32, 0.85, luma), 0, 1);
                  if (wBlue > 0.07) {
                    bluePixels.push(
                      idx,
                      infoB.s,
                      wBlue,
                      Math.min(255, Math.round(r * 0.45 + 115)),
                      Math.min(255, Math.round(g * 0.65 + 150)),
                      255
                    );
                  }
                }
              }

              // Bright orange-yellow golden ribbon pixels
              if (!insideRuneCore) {
                const goldSat = (r * 0.68 + g * 0.32 - b * 0.95) / 255;
                if (goldSat > 0.10 && r > 135 && g > 85) {
                  const infoG = nearestSplineInfo(nx, ny, goldSamples);
                  if (infoG.dist < 0.125) {
                    const prox = 1.0 - smoothstep(0.03, 0.125, infoG.dist);
                    const wGold = clamp(goldSat * 2.35 * prox * smoothstep(0.34, 0.88, luma), 0, 1);
                    if (wGold > 0.07) {
                      goldPixels.push(
                        idx,
                        infoG.s,
                        wGold,
                        255,
                        Math.min(255, Math.round(145 + luma * 105)),
                        Math.min(255, Math.round(35 + luma * 115))
                      );
                    }
                  }
                }
              }
            }
          }
        }

        auroraACtx.putImageData(auroraAImg, 0, 0);
        auroraBCtx.putImageData(auroraBImg, 0, 0);

        for (let z = 0; z < runeLayers.length; z++) {
          runeLayers[z].ctxCore.putImageData(runeLayers[z].imgCore, 0, 0);
          runeLayers[z].ctxDim.putImageData(runeLayers[z].imgDim, 0, 0);
        }

        return {
          img,
          auroraACanvas,
          auroraBCanvas,
          runeLayers,
          blueSamples,
          goldSamples,
          bluePixels: new Float32Array(bluePixels),
          goldPixels: new Float32Array(goldPixels)
        };
      }

      // =========================================================================
      // 5. Rendering Pipeline (100% Seamless over u in [0, 1))
      // =========================================================================
      function drawFallbackBackdrop(targetCtx, w, h, u, slideNum) {
        const grad = targetCtx.createLinearGradient(0, 0, w, h);
        grad.addColorStop(0, '#070d18');
        grad.addColorStop(0.55, '#0b1829');
        grad.addColorStop(1, '#060c15');
        targetCtx.fillStyle = grad;
        targetCtx.fillRect(0, 0, w, h);

        // Soft animated aurora hint behind the drop prompt
        const wave = Math.sin(u * Math.PI * 2);
        targetCtx.save();
        targetCtx.globalCompositeOperation = 'lighter';
        const ag = targetCtx.createRadialGradient(
          w * (0.62 + wave * 0.04), h * 0.22, w * 0.02,
          w * 0.65, h * 0.25, w * 0.36
        );
        ag.addColorStop(0, `rgba(52, 211, 153, ${0.18 + 0.08 * wave})`);
        ag.addColorStop(0.5, 'rgba(56, 189, 248, 0.08)');
        ag.addColorStop(1, 'rgba(0, 0, 0, 0)');
        targetCtx.fillStyle = ag;
        targetCtx.fillRect(0, 0, w, h);

        // Subtle warm rune stone glow hint
        const rg = targetCtx.createRadialGradient(
          w * (slideNum === 1 ? 0.71 : 0.77), h * 0.54, w * 0.01,
          w * (slideNum === 1 ? 0.71 : 0.77), h * 0.54, w * 0.18
        );
        const pulse = 0.5 - 0.5 * Math.cos(u * Math.PI * 2);
        rg.addColorStop(0, `rgba(251, 191, 36, ${0.14 + 0.14 * pulse})`);
        rg.addColorStop(1, 'rgba(0, 0, 0, 0)');
        targetCtx.fillStyle = rg;
        targetCtx.fillRect(0, 0, w, h);
        targetCtx.restore();
      }

      function renderFrame(u, slideNum, targetCtx, w, h) {
        const twoPi = Math.PI * 2;
        const data = slotData[slideNum];
        const meta = SLIDE_META[slideNum];
        const loopMult = getSeamlessLoopMultiplier();

        // If user hasn't loaded artwork for this slide yet, show an atmospheric placeholder
        if (!data) {
          drawFallbackBackdrop(targetCtx, w, h, u, slideNum);
          return;
        }

        // 1. Base high-resolution original artwork (preserves 100% razor-sharp text & art)
        targetCtx.save();
        targetCtx.globalCompositeOperation = 'source-over';
        targetCtx.globalAlpha = 1.0;
        drawImageCover(targetCtx, data.img, w, h);

        // ---------------------------------------------------------------------
        // 2. SEESAWING NORTHERN LIGHTS (Stronger <-> Weaker across Sky Banks)
        //    Exact integer cycles per master loop: sin(2π * uAurora)
        // ---------------------------------------------------------------------
        if (params.aurora > 0.01) {
          const uAurora = (u * Math.round(speeds.aurora * loopMult)) % 1.0;
          const seesaw = Math.sin(uAurora * twoPi); // smoothly oscillates -1 .. +1 .. 0
          const strengthA = (0.5 + 0.5 * seesaw) * params.aurora;
          const strengthB = (0.5 - 0.5 * seesaw) * params.aurora;

          // Subtle dimming during the weak side of the seesaw so the brightening feels dramatic
          const dipAlpha = clamp((0.36 - 0.24 * Math.abs(seesaw)) * params.aurora * 0.45, 0, 0.28);
          if (dipAlpha > 0.01) {
            targetCtx.save();
            targetCtx.globalCompositeOperation = 'multiply';
            const skyDim = targetCtx.createLinearGradient(0, 0, 0, h * 0.5);
            skyDim.addColorStop(0, `rgba(18, 30, 44, ${dipAlpha})`);
            skyDim.addColorStop(1, 'rgba(255, 255, 255, 0)');
            targetCtx.fillStyle = skyDim;
            targetCtx.fillRect(w * 0.34, 0, w * 0.66, h * 0.5);
            targetCtx.restore();
          }

          // Additive shimmering aurora banks with gentle vertical breath
          targetCtx.save();
          targetCtx.globalCompositeOperation = 'lighter';

          const shiftA = Math.sin(uAurora * twoPi) * h * 0.008;
          targetCtx.globalAlpha = clamp(strengthA * 0.62, 0, 0.92);
          targetCtx.drawImage(data.auroraACanvas, 0, shiftA, w, h);

          // Soft atmospheric bloom over Bank A
          targetCtx.filter = 'blur(8px)';
          targetCtx.globalAlpha = clamp(strengthA * 0.42, 0, 0.72);
          targetCtx.drawImage(data.auroraACanvas, 0, shiftA * 1.4, w, h);
          targetCtx.filter = 'none';

          const shiftB = -Math.sin(uAurora * twoPi) * h * 0.008;
          targetCtx.globalAlpha = clamp(strengthB * 0.68, 0, 0.95);
          targetCtx.drawImage(data.auroraBCanvas, 0, shiftB, w, h);

          targetCtx.filter = 'blur(9px)';
          targetCtx.globalAlpha = clamp(strengthB * 0.46, 0, 0.75);
          targetCtx.drawImage(data.auroraBCanvas, 0, shiftB * 1.4, w, h);
          targetCtx.filter = 'none';

          targetCtx.restore();
        }

        // ---------------------------------------------------------------------
        // 3. RUNE GLOW ON & OFF (Most Intense Radiance on the Carved 'Letters')
        //    Exact integer cycles per master loop: 0.5 - 0.5 * cos(2π * uRune)
        // ---------------------------------------------------------------------
        if (params.rune > 0.01) {
          const uRune = (u * Math.round(speeds.rune * loopMult)) % 1.0;

          for (let z = 0; z < data.runeLayers.length; z++) {
            const rl = data.runeLayers[z];
            const zn = rl.zone;
            const zPhase = (uRune + zn.phaseOffset) % 1.0;
            // Smooth pulse: 0 = dim/nearly off, 1 = peak blazing letter glow
            const pulse = 0.5 - 0.5 * Math.cos(zPhase * twoPi);
            const dimAmount = Math.pow(1.0 - pulse, 1.35) * clamp(params.rune, 0, 1.25);
            const glowAmount = Math.pow(pulse, 1.25) * params.rune;

            // Phase A: Gently dim carved letters during the "off" valley
            if (dimAmount > 0.02) {
              targetCtx.save();
              targetCtx.globalCompositeOperation = 'source-over';
              targetCtx.globalAlpha = clamp(dimAmount * 0.62, 0, 0.72);
              targetCtx.drawImage(rl.cDim, 0, 0, w, h);
              targetCtx.restore();
            }

            // Phase B: Warm halo + blazing intense letter core during the "on" peak
            if (glowAmount > 0.02) {
              targetCtx.save();
              targetCtx.globalCompositeOperation = 'lighter';

              // Soft golden aura around the stone face
              const cx = zn.cx * w;
              const cy = zn.cy * h;
              const haloRad = Math.max(zn.rx * w, zn.ry * h) * 1.15;
              const halo = targetCtx.createRadialGradient(cx, cy, haloRad * 0.06, cx, cy, haloRad);
              halo.addColorStop(0, `rgba(255, 210, 95, ${clamp(glowAmount * 0.34, 0, 0.55)})`);
              halo.addColorStop(0.55, `rgba(245, 148, 36, ${clamp(glowAmount * 0.16, 0, 0.30)})`);
              halo.addColorStop(1, 'rgba(0, 0, 0, 0)');
              targetCtx.fillStyle = halo;
              targetCtx.beginPath();
              targetCtx.arc(cx, cy, haloRad, 0, twoPi);
              targetCtx.fill();

              // Soft bloom strictly from the carved letters
              targetCtx.filter = 'blur(5px)';
              targetCtx.globalAlpha = clamp(glowAmount * 0.72, 0, 1.0);
              targetCtx.drawImage(rl.cCore, 0, 0, w, h);
              targetCtx.filter = 'none';

              // Crisp blazing hot core directly on the carved 'letters'
              targetCtx.globalAlpha = clamp(glowAmount * 0.92, 0, 1.0);
              targetCtx.drawImage(rl.cCore, 0, 0, w, h);

              targetCtx.restore();
            }
          }

          // Subtle twinkling on floating sky runes
          if (meta.skyRunes && meta.skyRunes.length > 0) {
            targetCtx.save();
            targetCtx.globalCompositeOperation = 'lighter';
            for (let i = 0; i < meta.skyRunes.length; i++) {
              const sr = meta.skyRunes[i];
              const p = 0.5 + 0.5 * Math.sin(uRune * twoPi + i * 1.4);
              const rx = sr.x * w;
              const ry = sr.y * h;
              const rad = w * 0.016 * (0.7 + 0.55 * p);
              const rg = targetCtx.createRadialGradient(rx, ry, 0.5, rx, ry, rad);
              const a = clamp(p * params.rune * 0.45, 0, 0.65);
              rg.addColorStop(0, `rgba(210, 245, 255, ${a})`);
              rg.addColorStop(0.5, `rgba(96, 195, 255, ${a * 0.45})`);
              rg.addColorStop(1, 'rgba(0, 0, 0, 0)');
              targetCtx.fillStyle = rg;
              targetCtx.beginPath();
              targetCtx.arc(rx, ry, rad, 0, twoPi);
              targetCtx.fill();
            }
            targetCtx.restore();
          }
        }

        // ---------------------------------------------------------------------
        // 4. BIDIRECTIONAL 'ELECTRIC BLOOMING LIGHT' ALONG SWIRLING RIBBONS
        //    Flows smoothly DOWN (start -> end) AND UP (end -> start) across
        //    the exact painted blue and orange-yellow lines with zero loop jump.
        // ---------------------------------------------------------------------
        if (params.ribbon > 0.01) {
          const uRibbon = (u * Math.round(speeds.ribbon * loopMult)) % 1.0;
          renderRibbonElectricBloom(uRibbon, data, targetCtx, w, h, params.ribbon);
        }

        // ---------------------------------------------------------------------
        // 5. SEAMLESS RISING RUNES & WARM/COOL EMBERS
        // ---------------------------------------------------------------------
        if (params.sparks > 0.01) {
          const uSparks = (u * Math.round(speeds.sparks * loopMult)) % 1.0;
          drawSeamlessEmbers(targetCtx, w, h, uSparks, params.sparks);
        }

        // Optional alignment preview overlay so user can inspect extracted zones
        if (showGuides) {
          drawMaskGuides(targetCtx, w, h, meta);
        }

        targetCtx.restore();
      }

      // Compute smooth bidirectional traveling waves along the actual ribbon pixels!
      // Wave span [-0.18 .. 1.18] ensures pulses enter smoothly at s=0 and exit smoothly at s=1
      // so u=0 and u=1 are 100% seamless with zero snapping!
      function evaluateBidirectionalWave(s, u, phaseShift) {
        const span = 1.36; // from -0.18 to +1.18
        const sigma = 0.095;
        const inv2SigmaSq = 1.0 / (2 * sigma * sigma);

        // One graceful DOWNWARD wave (start -> end) per cycle
        const d1 = ((u + phaseShift) % 1.0) * span - 0.18;

        // One graceful UPWARD wave (end -> start) staggered cleanly by half a cycle
        const u1 = 1.18 - (((u + phaseShift + 0.5) % 1.0) * span);

        const dd1 = s - d1;
        const du1 = s - u1;

        const wDown = Math.exp(-dd1 * dd1 * inv2SigmaSq);
        const wUp = Math.exp(-du1 * du1 * inv2SigmaSq);

        // Gentle electric shimmer locked to integer harmonic (2 cycles per ribbon cycle)
        const crackle = 0.90 + 0.10 * Math.sin(s * 24.0 - u * Math.PI * 4.0);
        return Math.min(1.25, (wDown + wUp * 0.94) * crackle);
      }

      function renderRibbonElectricBloom(u, data, targetCtx, w, h, strength) {
        const out = ribbonImgData.data;
        out.fill(0);

        const bArr = data.bluePixels;
        for (let i = 0; i < bArr.length; i += 6) {
          const idx = bArr[i];
          const s = bArr[i + 1];
          const weight = bArr[i + 2];
          const wave = evaluateBidirectionalWave(s, u, 0.0);
          const intensity = weight * wave * strength;
          if (intensity > 0.03) {
            const a = clamp(intensity * 0.95, 0, 1);
            const r = Math.min(255, Math.round(bArr[i + 3] + 75 * wave));
            const g = Math.min(255, Math.round(bArr[i + 4] + 65 * wave));
            const b = bArr[i + 5];
            out[idx] = r;
            out[idx + 1] = g;
            out[idx + 2] = b;
            out[idx + 3] = Math.round(a * 255);
          }
        }

        const gArr = data.goldPixels;
        for (let i = 0; i < gArr.length; i += 6) {
          const idx = gArr[i];
          const s = gArr[i + 1];
          const weight = gArr[i + 2];
          const wave = evaluateBidirectionalWave(s, u, 0.25);
          const intensity = weight * wave * strength;
          if (intensity > 0.03) {
            const a = clamp(intensity * 0.98, 0, 1);
            const addR = gArr[i + 3];
            const addG = Math.min(255, Math.round(gArr[i + 4] + 55 * wave));
            const addB = Math.min(255, Math.round(gArr[i + 5] + 95 * wave * wave));
            // Screen-blend cleanly where blue and gold ribbons cross
            out[idx] = Math.min(255, out[idx] + addR);
            out[idx + 1] = Math.min(255, out[idx + 1] + addG);
            out[idx + 2] = Math.min(255, out[idx + 2] + addB);
            out[idx + 3] = Math.min(255, Math.max(out[idx + 3], Math.round(a * 255)));
          }
        }

        ribbonBufCtx.putImageData(ribbonImgData, 0, 0);

        // Downsample into half-res canvas for creamy electric bloom halo
        ribbonBlurCtx.clearRect(0, 0, ribbonBlurCanvas.width, ribbonBlurCanvas.height);
        ribbonBlurCtx.drawImage(ribbonBufCanvas, 0, 0, ribbonBlurCanvas.width, ribbonBlurCanvas.height);

        targetCtx.save();
        targetCtx.globalCompositeOperation = 'lighter';

        // Soft outer electric bloom
        targetCtx.filter = 'blur(6px)';
        targetCtx.globalAlpha = clamp(0.68 * strength, 0, 0.95);
        targetCtx.drawImage(ribbonBlurCanvas, 0, 0, w, h);
        targetCtx.filter = 'none';

        // Crisp glowing filament directly on the painted ribbon strands
        targetCtx.globalAlpha = clamp(0.85 * strength, 0, 1.0);
        targetCtx.drawImage(ribbonBufCanvas, 0, 0, w, h);

        // Subtle traveling electric crest glints along the spline centerlines
        drawTravelingCrestGlints(targetCtx, w, h, data.blueSamples, u, 0.0, 'blue', strength);
        drawTravelingCrestGlints(targetCtx, w, h, data.goldSamples, u, 0.25, 'gold', strength);

        targetCtx.restore();
      }

      function drawTravelingCrestGlints(targetCtx, w, h, samples, u, phaseShift, colorTheme, strength) {
        const span = 1.36;
        const positions = [
          ((u + phaseShift) % 1.0) * span - 0.18,
          1.18 - (((u + phaseShift + 0.5) % 1.0) * span)
        ];

        const maxIdx = samples.length - 1;
        for (let k = 0; k < positions.length; k++) {
          const s = positions[k];
          if (s <= -0.02 || s >= 1.02) continue;
          // Smooth fade in at start point (s=0) and fade out at end point (s=1)
          const endFade = smoothstep(-0.02, 0.08, s) * (1.0 - smoothstep(0.92, 1.02, s));
          if (endFade <= 0.01) continue;

          const fIdx = Math.max(0, Math.min(maxIdx - 0.001, s * maxIdx));
          const i0 = Math.floor(fIdx);
          const frac = fIdx - i0;
          const p0 = samples[i0];
          const p1 = samples[i0 + 1];
          const gx = (p0.x + (p1.x - p0.x) * frac) * w;
          const gy = (p0.y + (p1.y - p0.y) * frac) * h;

          // Locked to 2 cycles per ribbon cycle so crest glints stay 100% seamless
          const rad = w * 0.028 * (0.85 + 0.15 * Math.sin(u * Math.PI * 4 + k * Math.PI));
          const grad = targetCtx.createRadialGradient(gx, gy, 0.5, gx, gy, rad);
          const a = clamp(endFade * strength * 0.52, 0, 0.78);
          if (colorTheme === 'blue') {
            grad.addColorStop(0, `rgba(235, 252, 255, ${a})`);
            grad.addColorStop(0.35, `rgba(96, 212, 255, ${a * 0.55})`);
            grad.addColorStop(1, 'rgba(0, 0, 0, 0)');
          } else {
            grad.addColorStop(0, `rgba(255, 248, 215, ${a})`);
            grad.addColorStop(0.35, `rgba(255, 178, 56, ${a * 0.55})`);
            grad.addColorStop(1, 'rgba(0, 0, 0, 0)');
          }
          targetCtx.fillStyle = grad;
          targetCtx.beginPath();
          targetCtx.arc(gx, gy, rad, 0, Math.PI * 2);
          targetCtx.fill();
        }
      }

      function drawSeamlessEmbers(targetCtx, w, h, u, strength) {
        const twoPi = Math.PI * 2;
        targetCtx.save();
        targetCtx.globalCompositeOperation = 'lighter';

        for (let i = 0; i < embers.length; i++) {
          const e = embers[i];
          const life = (u + e.phase) % 1.0; // strictly periodic over [0, 1)
          const fade = Math.sin(life * Math.PI); // 0 at start, 1 at peak, 0 at end
          if (fade <= 0.02) continue;

          const x = (e.baseX + Math.sin((u * e.swayFreq + e.phase) * twoPi) * e.swayAmp) * w;
          const y = (e.baseY - life * e.rise) * h;
          const r = e.radius * (w / 960) * (0.65 + 0.55 * fade);
          const a = clamp(fade * strength * 0.72, 0, 0.9);

          const g = targetCtx.createRadialGradient(x, y, 0.2, x, y, r * 2.6);
          if (e.warm) {
            g.addColorStop(0, `rgba(255, 242, 195, ${a})`);
            g.addColorStop(0.45, `rgba(255, 168, 52, ${a * 0.65})`);
            g.addColorStop(1, 'rgba(0, 0, 0, 0)');
          } else {
            g.addColorStop(0, `rgba(225, 250, 255, ${a})`);
            g.addColorStop(0.45, `rgba(86, 204, 255, ${a * 0.6})`);
            g.addColorStop(1, 'rgba(0, 0, 0, 0)');
          }
          targetCtx.fillStyle = g;
          targetCtx.beginPath();
          targetCtx.arc(x, y, r * 2.6, 0, twoPi);
          targetCtx.fill();
        }

        targetCtx.restore();
      }

      function drawMaskGuides(targetCtx, w, h, meta) {
        targetCtx.save();
        targetCtx.lineWidth = 1.5;

        // Rune ellipses
        targetCtx.strokeStyle = 'rgba(251, 191, 36, 0.85)';
        targetCtx.setLineDash([5, 4]);
        for (let z = 0; z < meta.runeZones.length; z++) {
          const zn = meta.runeZones[z];
          targetCtx.beginPath();
          targetCtx.ellipse(zn.cx * w, zn.cy * h, zn.rx * w, zn.ry * h, 0, 0, Math.PI * 2);
          targetCtx.stroke();
        }

        // Blue ribbon path
        targetCtx.setLineDash([]);
        targetCtx.strokeStyle = 'rgba(56, 189, 248, 0.9)';
        targetCtx.beginPath();
        const bs = sampleSplineArcLength(meta.blueSpline, 80);
        for (let i = 0; i < bs.length; i++) {
          if (i === 0) targetCtx.moveTo(bs[i].x * w, bs[i].y * h);
          else targetCtx.lineTo(bs[i].x * w, bs[i].y * h);
        }
        targetCtx.stroke();

        // Gold ribbon path
        targetCtx.strokeStyle = 'rgba(251, 146, 60, 0.9)';
        targetCtx.beginPath();
        const gs = sampleSplineArcLength(meta.goldSpline, 80);
        for (let i = 0; i < gs.length; i++) {
          if (i === 0) targetCtx.moveTo(gs[i].x * w, gs[i].y * h);
          else targetCtx.lineTo(gs[i].x * w, gs[i].y * h);
        }
        targetCtx.stroke();

        targetCtx.restore();
      }

      // =========================================================================
      // 6. Adaptive 255-Color Median-Cut Palette + 4x4 Bayer Dither +
      //    Delta-Compressed Pure-JS GIF89a/LZW Encoder
      // =========================================================================
      const BAYER_4X4 = [
        -7.5,  0.5, -5.5,  2.5,
         4.5, -3.5,  6.5, -1.5,
        -4.5,  3.5, -6.5,  1.5,
         7.5, -0.5,  5.5, -2.5
      ];

      function buildMedianCutPalette(samplesRgb, maxColors) {
        // Each sample is [r, g, b]; reserve index 255 for transparent delta key
        const boxes = [samplesRgb];

        while (boxes.length < maxColors) {
          let bestIdx = -1;
          let bestScore = -1;
          let bestChannel = 0;

          for (let i = 0; i < boxes.length; i++) {
            const box = boxes[i];
            if (box.length < 2) continue;
            let minR = 255, maxR = 0, minG = 255, maxG = 0, minB = 255, maxB = 0;
            for (let j = 0; j < box.length; j++) {
              const p = box[j];
              if (p[0] < minR) minR = p[0];
              if (p[0] > maxR) maxR = p[0];
              if (p[1] < minG) minG = p[1];
              if (p[1] > maxG) maxG = p[1];
              if (p[2] < minB) minB = p[2];
              if (p[2] > maxB) maxB = p[2];
            }
            const rRange = maxR - minR;
            const gRange = maxG - minG;
            const bRange = maxB - minB;
            const maxRange = Math.max(rRange, gRange, bRange);
            if (maxRange === 0) continue;
            const score = maxRange * Math.sqrt(box.length);
            if (score > bestScore) {
              bestScore = score;
              bestIdx = i;
              bestChannel = gRange >= rRange && gRange >= bRange ? 1 : (rRange >= bRange ? 0 : 2);
            }
          }

          if (bestIdx === -1) break;
          const target = boxes.splice(bestIdx, 1)[0];
          target.sort((a, b) => a[bestChannel] - b[bestChannel]);
          const mid = target.length >> 1;
          boxes.push(target.slice(0, mid));
          boxes.push(target.slice(mid));
        }

        const palette = new Uint8Array(256 * 3);
        for (let i = 0; i < boxes.length && i < 255; i++) {
          const box = boxes[i];
          let sr = 0, sg = 0, sb = 0;
          for (let j = 0; j < box.length; j++) {
            sr += box[j][0];
            sg += box[j][1];
            sb += box[j][2];
          }
          const n = Math.max(1, box.length);
          palette[i * 3] = Math.round(sr / n);
          palette[i * 3 + 1] = Math.round(sg / n);
          palette[i * 3 + 2] = Math.round(sb / n);
        }
        // Index 255 is transparent key
        palette[255 * 3] = 0;
        palette[255 * 3 + 1] = 0;
        palette[255 * 3 + 2] = 0;
        return { palette, usedColors: Math.min(255, boxes.length) };
      }

      // 5-bit per channel (32x32x32) nearest-palette lookup table for super-fast quantization
      function buildPaletteLUT(palette, usedColors) {
        const lut = new Uint8Array(32 * 32 * 32);
        for (let r5 = 0; r5 < 32; r5++) {
          const r = (r5 << 3) | 4;
          for (let g5 = 0; g5 < 32; g5++) {
            const g = (g5 << 3) | 4;
            for (let b5 = 0; b5 < 32; b5++) {
              const b = (b5 << 3) | 4;
              let best = 0;
              let bestDist = 1e12;
              for (let c = 0; c < usedColors; c++) {
                const dr = r - palette[c * 3];
                const dg = g - palette[c * 3 + 1];
                const db = b - palette[c * 3 + 2];
                // Perceptually weighted Euclidean distance
                const d = dr * dr * 2 + dg * dg * 4 + db * db * 3;
                if (d < bestDist) {
                  bestDist = d;
                  best = c;
                }
              }
              lut[(r5 << 10) | (g5 << 5) | b5] = best;
            }
          }
        }
        return lut;
      }

      function quantizeFrameWithDither(rgba, w, h, lut, outIndices) {
        for (let y = 0; y < h; y++) {
          const bayerRow = (y & 3) << 2;
          const rowOff = y * w;
          for (let x = 0; x < w; x++) {
            const p = rowOff + x;
            const i4 = p << 2;
            const dither = BAYER_4X4[bayerRow | (x & 3)] * 1.15;
            const r = clamp(Math.round(rgba[i4] + dither), 0, 255);
            const g = clamp(Math.round(rgba[i4 + 1] + dither), 0, 255);
            const b = clamp(Math.round(rgba[i4 + 2] + dither), 0, 255);
            outIndices[p] = lut[((r >> 3) << 10) | ((g >> 3) << 5) | (b >> 3)];
          }
        }
      }

      function lzwEncode(indices, minCodeSize) {
        const clearCode = 1 << minCodeSize;
        const eoiCode = clearCode + 1;
        let codeSize = minCodeSize + 1;
        let nextCode = eoiCode + 1;

        const outBytes = [];
        let bitBuf = 0;
        let bitCount = 0;

        function writeCode(code) {
          bitBuf |= code << bitCount;
          bitCount += codeSize;
          while (bitCount >= 8) {
            outBytes.push(bitBuf & 0xff);
            bitBuf >>>= 8;
            bitCount -= 8;
          }
        }

        // Open-addressing hash table for fast LZW dictionary lookups
        const TABLE_SIZE = 16384;
        const keys = new Int32Array(TABLE_SIZE);
        const vals = new Int16Array(TABLE_SIZE);
        keys.fill(-1);

        function resetTable() {
          keys.fill(-1);
          codeSize = minCodeSize + 1;
          nextCode = eoiCode + 1;
        }

        writeCode(clearCode);
        if (indices.length === 0) {
          writeCode(eoiCode);
          if (bitCount > 0) outBytes.push(bitBuf & 0xff);
          return outBytes;
        }

        let prefix = indices[0];
        for (let i = 1; i < indices.length; i++) {
          const suffix = indices[i];
          const key = (prefix << 8) | suffix;
          let slot = ((key * 2654435761) >>> 18) & (TABLE_SIZE - 1);
          let found = -1;

          while (keys[slot] !== -1) {
            if (keys[slot] === key) {
              found = vals[slot];
              break;
            }
            slot = (slot + 1) & (TABLE_SIZE - 1);
          }

          if (found !== -1) {
            prefix = found;
          } else {
            writeCode(prefix);
            if (nextCode < 4096) {
              keys[slot] = key;
              vals[slot] = nextCode++;
              if (nextCode > (1 << codeSize) && codeSize < 12) {
                codeSize++;
              }
            } else {
              writeCode(clearCode);
              resetTable();
            }
            prefix = suffix;
          }
        }

        writeCode(prefix);
        writeCode(eoiCode);
        if (bitCount > 0) outBytes.push(bitBuf & 0xff);
        return outBytes;
      }

      function createGifBuilder(w, h, palette) {
        const chunks = [];
        function pushBytes(arr) {
          chunks.push(new Uint8Array(arr));
        }

        // GIF89a Header + Logical Screen Descriptor (Global Color Table, 256 colors)
        pushBytes([
          0x47, 0x49, 0x46, 0x38, 0x39, 0x61,
          w & 0xff, (w >> 8) & 0xff,
          h & 0xff, (h >> 8) & 0xff,
          0xf7, 0x00, 0x00
        ]);
        chunks.push(palette);

        // NETSCAPE2.0 Infinite Loop Application Extension
        pushBytes([
          0x21, 0xff, 0x0b,
          0x4e, 0x45, 0x54, 0x53, 0x43, 0x41, 0x50, 0x45, 0x32, 0x2e, 0x30,
          0x03, 0x01, 0x00, 0x00, 0x00
        ]);

        return {
          addFrame(indices, delayCs, useTransparency, left, top, fw, fh) {
            // Graphic Control Extension (Disposal 1 = Do Not Dispose; optional transparent index 255)
            const packed = useTransparency ? 0x05 : 0x04;
            pushBytes([
              0x21, 0xf9, 0x04,
              packed,
              delayCs & 0xff, (delayCs >> 8) & 0xff,
              useTransparency ? 255 : 0,
              0x00
            ]);

            // Image Descriptor
            pushBytes([
              0x2c,
              left & 0xff, (left >> 8) & 0xff,
              top & 0xff, (top >> 8) & 0xff,
              fw & 0xff, (fw >> 8) & 0xff,
              fh & 0xff, (fh >> 8) & 0xff,
              0x00
            ]);

            // LZW Compressed Image Data sub-blocks
            const minCodeSize = 8;
            const encoded = lzwEncode(indices, minCodeSize);
            const blockArr = [minCodeSize];
            let pos = 0;
            while (pos < encoded.length) {
              const size = Math.min(255, encoded.length - pos);
              blockArr.push(size);
              for (let k = 0; k < size; k++) {
                blockArr.push(encoded[pos + k]);
              }
              pos += size;
            }
            blockArr.push(0x00);
            pushBytes(blockArr);
          },
          finish() {
            pushBytes([0x3b]); // GIF Trailer
            let total = 0;
            for (let i = 0; i < chunks.length; i++) total += chunks[i].length;
            const out = new Uint8Array(total);
            let offset = 0;
            for (let i = 0; i < chunks.length; i++) {
              out.set(chunks[i], offset);
              offset += chunks[i].length;
            }
            return out;
          }
        };
      }

      function nextUiTick() {
        return new Promise((resolve) => setTimeout(resolve, 12));
      }

      async function exportSeamlessGif() {
        if (isExporting) return;
        if (!slotData[activeSlide]) {
          showStatus(`Please load your ${SLIDE_META[activeSlide].displayName} image first before exporting.`, 'error');
          return;
        }

        isExporting = true;
        btnExportGif.disabled = true;

        try {
          const baseDuration = parseFloat(loopSecondsSelect.value) || 8.0;
          const mult = getSeamlessLoopMultiplier();
          const effectiveDuration = baseDuration * mult;
          // Adapt FPS cleanly for slower multi-cycle loops to stay silky without giant file sizes
          const fps = Math.max(8, Math.min(20, Math.round(180 / effectiveDuration)));
          const totalFrames = Math.max(24, Math.round(effectiveDuration * fps));
          const delayCs = Math.max(2, Math.round(100 / fps));

          showStatus(
            `Step 1/2: Building adaptive 255-color artwork palette (${outW}x${outH}, ${effectiveDuration.toFixed(1)}s seamless loop)...`,
            'info'
          );
          await nextUiTick();

          const expCanvas = document.createElement('canvas');
          expCanvas.width = outW;
          expCanvas.height = outH;
          const expCtx = expCanvas.getContext('2d', { alpha: false, willReadFrequently: true });

          // Sample 6 evenly spaced phases across the loop so peak aurora, peak rune glow & ribbons enter palette
          const samplesRgb = [];
          const samplePhases = 6;
          const pixelStride = Math.max(4, Math.floor((outW * outH) / 7500));
          for (let sp = 0; sp < samplePhases; sp++) {
            renderFrame(sp / samplePhases, activeSlide, expCtx, outW, outH);
            const rgba = expCtx.getImageData(0, 0, outW, outH).data;
            for (let p = 0; p < outW * outH; p += pixelStride) {
              const i4 = p << 2;
              samplesRgb.push([rgba[i4], rgba[i4 + 1], rgba[i4 + 2]]);
            }
          }

          const { palette, usedColors } = buildMedianCutPalette(samplesRgb, 255);
          const lut = buildPaletteLUT(palette, usedColors);
          const gif = createGifBuilder(outW, outH, palette);

          const currIndices = new Uint8Array(outW * outH);
          const prevIndices = new Uint8Array(outW * outH);

          // Step 2: Render exact frames u = f / totalFrames (strictly [0, 1), NO duplicate end frame!)
          for (let f = 0; f < totalFrames; f++) {
            const u = f / totalFrames;
            renderFrame(u, activeSlide, expCtx, outW, outH);
            const rgba = expCtx.getImageData(0, 0, outW, outH).data;
            quantizeFrameWithDither(rgba, outW, outH, lut, currIndices);

            if (f === 0) {
              gif.addFrame(currIndices, delayCs, false, 0, 0, outW, outH);
              prevIndices.set(currIndices);
            } else {
              // Compute tight dirty bounding box + transparent unchanged pixels for zero text flicker
              let minX = outW, minY = outH, maxX = -1, maxY = -1;
              for (let y = 0; y < outH; y++) {
                const row = y * outW;
                for (let x = 0; x < outW; x++) {
                  const p = row + x;
                  if (currIndices[p] !== prevIndices[p]) {
                    if (x < minX) minX = x;
                    if (x > maxX) maxX = x;
                    if (y < minY) minY = y;
                    if (y > maxY) maxY = y;
                  }
                }
              }

              if (maxX < minX) {
                // Identical frame — emit a tiny 1x1 transparent frame
                gif.addFrame(new Uint8Array([255]), delayCs, true, 0, 0, 1, 1);
              } else {
                const bw = maxX - minX + 1;
                const bh = maxY - minY + 1;
                const sub = new Uint8Array(bw * bh);
                for (let y = 0; y < bh; y++) {
                  const srcRow = (minY + y) * outW + minX;
                  const dstRow = y * bw;
                  for (let x = 0; x < bw; x++) {
                    const c = currIndices[srcRow + x];
                    if (c === prevIndices[srcRow + x]) {
                      sub[dstRow + x] = 255; // transparent — keeps previous pixel rock-solid
                    } else {
                      sub[dstRow + x] = c;
                      prevIndices[srcRow + x] = c;
                    }
                  }
                }
                gif.addFrame(sub, delayCs, true, minX, minY, bw, bh);
              }
            }

            if (f % 4 === 0 || f === totalFrames - 1) {
              const pct = Math.round(((f + 1) / totalFrames) * 100);
              showStatus(
                `Step 2/2: Encoding frame ${f + 1}/${totalFrames} (${pct}%) with adaptive dithering & delta compression...`,
                'info'
              );
              await nextUiTick();
            }
          }

          const bytes = gif.finish();
          const blob = new Blob([bytes], { type: 'image/gif' });
          const url = URL.createObjectURL(blob);
          const fname = SLIDE_META[activeSlide].filename;
          const a = document.createElement('a');
          a.href = url;
          a.download = fname;
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          setTimeout(() => URL.revokeObjectURL(url), 4000);

          const mb = (bytes.length / (1024 * 1024)).toFixed(2);
          showStatus(
            `Exported ${fname} (${mb} MB, ${effectiveDuration.toFixed(1)}s, ${totalFrames} frames @ ${fps} fps, 100% seamless loop). Upload straight to your GitHub repo!`,
            'success'
          );
        } catch (err) {
          showStatus(`GIF export error: ${err && err.message ? err.message : String(err)}`, 'error');
        } finally {
          isExporting = false;
          btnExportGif.disabled = false;
        }
      }

      // =========================================================================
      // 7. Ambient Warm Nordic Drone (D2 - A2 - D3)
      // =========================================================================
      function toggleAudio() {
        try {
          if (!audioEnabled) {
            const AudioCtx = window.AudioContext || window.webkitAudioContext;
            if (!audioCtx) {
              audioCtx = new AudioCtx();
            }
            if (audioCtx.state === 'suspended') {
              audioCtx.resume();
            }

            audioMaster = audioCtx.createGain();
            audioMaster.gain.setValueAtTime(0.0001, audioCtx.currentTime);
            audioMaster.gain.exponentialRampToValueAtTime(0.11, audioCtx.currentTime + 1.2);

            audioFilterA = audioCtx.createBiquadFilter();
            audioFilterA.type = 'lowpass';
            audioFilterA.frequency.setValueAtTime(300, audioCtx.currentTime);
            audioFilterA.Q.setValueAtTime(1.2, audioCtx.currentTime);

            audioFilterA.connect(audioMaster);
            audioMaster.connect(audioCtx.destination);

            // Warm open fifth harmonic drone: D2 (73.42), A2 (110.0), D3 (146.83)
            const freqs = [
              { f: 73.42, type: 'sine', gain: 0.55 },
              { f: 110.00, type: 'triangle', gain: 0.24 },
              { f: 146.83, type: 'sine', gain: 0.21 }
            ];

            audioNodes = freqs.map((cfg) => {
              const osc = audioCtx.createOscillator();
              const g = audioCtx.createGain();
              osc.type = cfg.type;
              osc.frequency.setValueAtTime(cfg.f, audioCtx.currentTime);
              g.gain.setValueAtTime(cfg.gain, audioCtx.currentTime);
              osc.connect(g);
              g.connect(audioFilterA);
              osc.start();
              return osc;
            });

            audioEnabled = true;
            btnAudio.textContent = 'Ambient Drone: On';
            btnAudio.classList.remove('bg-slate-800', 'text-slate-200');
            btnAudio.classList.add('bg-emerald-500/20', 'text-emerald-200', 'border-emerald-400/50');
          } else {
            if (audioMaster && audioCtx) {
              const now = audioCtx.currentTime;
              audioMaster.gain.cancelScheduledValues(now);
              audioMaster.gain.setTargetAtTime(0.0001, now, 0.12);
              const stopList = audioNodes.slice();
              setTimeout(() => {
                stopList.forEach((osc) => {
                  try { osc.stop(); } catch (_) {}
                });
              }, 350);
            }
            audioNodes = [];
            audioEnabled = false;
            btnAudio.textContent = 'Ambient Drone: Off';
            btnAudio.classList.add('bg-slate-800', 'text-slate-200');
            btnAudio.classList.remove('bg-emerald-500/20', 'text-emerald-200', 'border-emerald-400/50');
          }
        } catch (err) {
          showStatus(`Audio unavailable: ${err.message}`, 'error');
        }
      }

      // =========================================================================
      // 8. Image Loading, Drag & Drop, Slide Switching & Preview Loop
      // =========================================================================
      function updateEmptyPromptVisibility() {
        const hasArt = Boolean(slotData[activeSlide]);
        emptyPrompt.style.opacity = hasArt ? '0' : '1';
        emptyPrompt.style.pointerEvents = hasArt ? 'none' : 'auto';
        emptySlideName.textContent = SLIDE_META[activeSlide].displayName;
      }

      function updateSlotIndicators() {
        if (slotData[1]) {
          dotSlide1.className = 'w-2 h-2 rounded-full bg-emerald-400 shadow-[0_0_8px_#34d399]';
        } else {
          dotSlide1.className = 'w-2 h-2 rounded-full bg-slate-600';
        }
        if (slotData[2]) {
          dotSlide2.className = 'w-2 h-2 rounded-full bg-emerald-400 shadow-[0_0_8px_#34d399]';
        } else {
          dotSlide2.className = 'w-2 h-2 rounded-full bg-slate-600';
        }
      }

      function loadArtworkForSlot(file, slotNum) {
        if (!file || !file.type.startsWith('image/')) {
          showStatus('Please choose a valid JPEG or PNG image file.', 'error');
          return;
        }
        const reader = new FileReader();
        reader.onload = function (ev) {
          const img = new Image();
          img.onload = function () {
            try {
              slotData[slotNum] = extractArtworkMasks(img, slotNum);
              if (slotNum === 1) {
                labelSlide1.textContent = `Loaded: ${file.name} (${img.naturalWidth}×${img.naturalHeight})`;
              } else {
                labelSlide2.textContent = `Loaded: ${file.name} (${img.naturalWidth}×${img.naturalHeight})`;
              }
              updateSlotIndicators();
              selectSlide(slotNum);
              showStatus(
                `Loaded ${file.name} into ${SLIDE_META[slotNum].displayName} — extracted aurora banks, carved rune letters, and blue/gold ribbon strands.`,
                'success'
              );
            } catch (err) {
              showStatus(`Could not analyze image: ${err.message}`, 'error');
            }
          };
          img.onerror = function () {
            showStatus('Could not decode that image file.', 'error');
          };
          img.src = ev.target.result;
        };
        reader.readAsDataURL(file);
      }

      function selectSlide(num) {
        activeSlide = num;
        if (num === 1) {
          btnSlide1.className =
            'px-3.5 py-2 rounded-lg text-xs sm:text-sm font-semibold transition-all cursor-pointer bg-amber-400/20 text-amber-200 border border-amber-400/50 shadow-sm flex items-center gap-2';
          btnSlide2.className =
            'px-3.5 py-2 rounded-lg text-xs sm:text-sm font-semibold transition-all cursor-pointer text-slate-300 hover:text-white border border-transparent flex items-center gap-2';
        } else {
          btnSlide2.className =
            'px-3.5 py-2 rounded-lg text-xs sm:text-sm font-semibold transition-all cursor-pointer bg-sky-400/20 text-sky-200 border border-sky-400/50 shadow-sm flex items-center gap-2';
          btnSlide1.className =
            'px-3.5 py-2 rounded-lg text-xs sm:text-sm font-semibold transition-all cursor-pointer text-slate-300 hover:text-white border border-transparent flex items-center gap-2';
        }
        updateEmptyPromptVisibility();
        renderFrame(loopPhase, activeSlide, ctx, canvas.width, canvas.height);
      }

      function updateResolution() {
        const parts = exportResSelect.value.split('x');
        outW = parseInt(parts[0], 10) || 960;
        outH = parseInt(parts[1], 10) || 540;
        canvas.width = outW;
        canvas.height = outH;
        renderFrame(loopPhase, activeSlide, ctx, canvas.width, canvas.height);
      }

      function wireDropTarget(el, getTargetSlot) {
        ['dragenter', 'dragover'].forEach((evt) => {
          el.addEventListener(evt, (e) => {
            e.preventDefault();
            e.stopPropagation();
            el.classList.add('drop-active');
          });
        });
        ['dragleave', 'drop'].forEach((evt) => {
          el.addEventListener(evt, (e) => {
            e.preventDefault();
            e.stopPropagation();
            el.classList.remove('drop-active');
          });
        });
        el.addEventListener('drop', (e) => {
          const files = e.dataTransfer && e.dataTransfer.files;
          if (files && files.length > 0) {
            loadArtworkForSlot(files[0], getTargetSlot());
          }
        });
      }

      // Main 60fps preview loop
      function tick(stamp) {
        if (lastStamp === null) lastStamp = stamp;
        const dt = Math.min(0.1, (stamp - lastStamp) / 1000);
        lastStamp = stamp;

        if (isPlaying && !isExporting) {
          const mult = getSeamlessLoopMultiplier();
          const effectiveDuration = loopDuration * mult;
          elapsedSec = (elapsedSec + dt) % effectiveDuration;
          loopPhase = elapsedSec / effectiveDuration;
          loopPhaseLabel.textContent = `${effectiveDuration.toFixed(1)}s · ${Math.floor(loopPhase * 100)}%`;

          // Gently breathe the ambient drone filter in sync with the aurora seesaw
          if (audioEnabled && audioFilterA && audioCtx) {
            const uAurora = (loopPhase * Math.round(speeds.aurora * mult)) % 1.0;
            const seesaw = Math.sin(uAurora * Math.PI * 2);
            audioFilterA.frequency.setTargetAtTime(300 + seesaw * 75, audioCtx.currentTime, 0.08);
          }

          renderFrame(loopPhase, activeSlide, ctx, canvas.width, canvas.height);
        }
        requestAnimationFrame(tick);
      }

      // =========================================================================
      // 9. Event Wiring & Initialization
      // =========================================================================
      btnSlide1.addEventListener('click', () => selectSlide(1));
      btnSlide2.addEventListener('click', () => selectSlide(2));

      fileSlide1.addEventListener('change', (e) => {
        if (e.target.files && e.target.files[0]) {
          loadArtworkForSlot(e.target.files[0], 1);
          e.target.value = '';
        }
      });
      fileSlide2.addEventListener('change', (e) => {
        if (e.target.files && e.target.files[0]) {
          loadArtworkForSlot(e.target.files[0], 2);
          e.target.value = '';
        }
      });

      wireDropTarget(stageContainer, () => activeSlide);
      wireDropTarget(cardUpload1, () => 1);
      wireDropTarget(cardUpload2, () => 2);

      btnPlayPause.addEventListener('click', () => {
        isPlaying = !isPlaying;
        btnPlayPause.textContent = isPlaying ? 'Pause' : 'Play';
      });

      btnAudio.addEventListener('click', toggleAudio);

      btnOverlay.addEventListener('click', () => {
        showGuides = !showGuides;
        btnOverlay.textContent = showGuides ? 'Mask Guides: On' : 'Mask Guides: Off';
        btnOverlay.classList.toggle('bg-amber-500/20', showGuides);
        btnOverlay.classList.toggle('text-amber-200', showGuides);
        btnOverlay.classList.toggle('border-amber-400/50', showGuides);
        renderFrame(loopPhase, activeSlide, ctx, canvas.width, canvas.height);
      });

      exportResSelect.addEventListener('change', updateResolution);
      loopSecondsSelect.addEventListener('change', () => {
        loopDuration = parseFloat(loopSecondsSelect.value) || 8.0;
      });

      slAurora.addEventListener('input', () => {
        params.aurora = Number(slAurora.value) / 100;
        valAurora.textContent = `${slAurora.value}%`;
      });
      slRibbon.addEventListener('input', () => {
        params.ribbon = Number(slRibbon.value) / 100;
        valRibbon.textContent = `${slRibbon.value}%`;
      });
      slRune.addEventListener('input', () => {
        params.rune = Number(slRune.value) / 100;
        valRune.textContent = `${slRune.value}%`;
      });
      slSparks.addEventListener('input', () => {
        params.sparks = Number(slSparks.value) / 100;
        valSparks.textContent = `${slSparks.value}%`;
      });

      slSpdAurora.addEventListener('input', () => {
        speeds.aurora = Number(slSpdAurora.value);
        valSpdAurora.textContent = formatSpeed(speeds.aurora);
      });
      slSpdRibbon.addEventListener('input', () => {
        speeds.ribbon = Number(slSpdRibbon.value);
        valSpdRibbon.textContent = formatSpeed(speeds.ribbon);
      });
      slSpdRune.addEventListener('input', () => {
        speeds.rune = Number(slSpdRune.value);
        valSpdRune.textContent = formatSpeed(speeds.rune);
      });
      slSpdSparks.addEventListener('input', () => {
        speeds.sparks = Number(slSpdSparks.value);
        valSpdSparks.textContent = formatSpeed(speeds.sparks);
      });

      btnExportGif.addEventListener('click', exportSeamlessGif);

      window.addEventListener('load', () => {
        updateResolution();
        selectSlide(1);
        requestAnimationFrame(tick);
      });
    })();
  </script>
</body>
</html>